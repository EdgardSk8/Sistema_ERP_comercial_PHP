{
  "rewrites": [
    { "source": "/tienda", "destination": "/index.html" },
    { "source": "/tienda/", "destination": "/index.html" },
    { "source": "/tienda/login", "destination": "/login.html" },
    { "source": "/tienda/carrito", "destination": "/carrito.html" },
    { "source": "/tienda/perfil", "destination": "/perfil.html" },
    { "source": "/tienda/trabajador", "destination": "/trabajador.html" },
    { "source": "/trabajador", "destination": "/trabajador.html" },
    { "source": "/tienda/trabaja-con-nosotros", "destination": "/trabaja-con-nosotros.html" },
    { "source": "/trabaja-con-nosotros", "destination": "/trabaja-con-nosotros.html" },
    { "source": "/tienda/ayuda", "destination": "/ayuda.html" },
    { "source": "/tienda/quienes-somos", "destination": "/quienes-somos.html" },
    { "source": "/tienda/terminos", "destination": "/terminos.html" },
    { "source": "/quienes-somos", "destination": "/quienes-somos.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/producto", "destination": "/producto.html" },
    { "source": "/tienda/producto/:id", "destination": "/producto.html" },
    { "source": "/tienda/recursos/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/imagenes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/tienda/recursos/imagenes/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ]
}
